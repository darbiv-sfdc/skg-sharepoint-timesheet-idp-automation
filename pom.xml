<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>dfb7e975-c094-4e2b-8895-a7742dcadd1d</groupId>
		<artifactId>skg-common-parent-pom</artifactId>
		<version>1.0.1</version>
	</parent>
	<groupId>dfb7e975-c094-4e2b-8895-a7742dcadd1d</groupId>
	<artifactId>skg-sharepoint-timesheet-idp-automation</artifactId>
	<version>1.0.0</version>
	<packaging>mule-application</packaging>
	<name>skg-sharepoint-timesheet-idp-automation</name>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<app.runtime>4.11.0</app.runtime>
		<!-- API Specification Properties -->
		<type>process-bo</type>
		<app.specification.artifactId>skg-idp-automation-template-papi</app.specification.artifactId>
		<app.specification.version>1.0.0</app.specification.version>
		<mule.maven.plugin.version>4.10.0</mule.maven.plugin.version>
	</properties>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.2.0</version>
			</plugin>
			<plugin>
				<groupId>org.mule.tools.maven</groupId>
				<artifactId>mule-maven-plugin</artifactId>
				<version>${mule.maven.plugin.version}</version>
				<extensions>true</extensions>
				<configuration>
					<classifier>mule-application</classifier>
					<sharedLibraries>
						<sharedLibrary>
							<groupId>org.codehaus.groovy</groupId>
							<artifactId>groovy-jsr223</artifactId>
						</sharedLibrary>
					</sharedLibraries>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<!-- Core HTTP Connector -->
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-http-connector</artifactId>
			<version>1.11.1</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<!-- Sockets Connector -->
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-sockets-connector</artifactId>
			<version>1.2.7</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<!-- APIkit Module -->
		<dependency>
			<groupId>org.mule.modules</groupId>
			<artifactId>mule-apikit-module</artifactId>
			<version>1.11.11</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<!-- Secure Properties Module -->
		<dependency>
			<groupId>com.mulesoft.modules</groupId>
			<artifactId>mule-secure-configuration-property-module</artifactId>
			<classifier>mule-plugin</classifier>
		</dependency>
		<!-- Your API Specification from Exchange -->
		<dependency>
			<groupId>dfb7e975-c094-4e2b-8895-a7742dcadd1d</groupId>
			<artifactId>skg-idp-automation-template-papi</artifactId>
			<version>1.0.0</version>
			<classifier>raml</classifier>
			<type>zip</type>
		</dependency>
		<!-- SKG Health Check Plugin -->
		<dependency>
			<groupId>dfb7e975-c094-4e2b-8895-a7742dcadd1d</groupId>
			<artifactId>skg-health-check-app</artifactId>
			<classifier>mule-plugin</classifier>
		</dependency>
		<!-- SKG Common Error Handling Plugin -->
		<dependency>
			<groupId>dfb7e975-c094-4e2b-8895-a7742dcadd1d</groupId>
			<artifactId>skg-common-error-handling</artifactId>
			<classifier>mule-plugin</classifier>
		</dependency>
		<!-- DataWeave Libraries -->
		<dependency>
			<groupId>dfb7e975-c094-4e2b-8895-a7742dcadd1d</groupId>
			<artifactId>skg-dw-library-log-mapper</artifactId>
			<classifier>dw-library</classifier>
		</dependency>
		<dependency>
			<groupId>dfb7e975-c094-4e2b-8895-a7742dcadd1d</groupId>
			<artifactId>skg-dw-library-error-mapper</artifactId>
			<classifier>dw-library</classifier>
		</dependency>
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-file-connector</artifactId>
			<version>1.5.3</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>com.mulesoft.connectors</groupId>
			<artifactId>mule-sharepoint-connector</artifactId>
			<version>3.9.0</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>org.mule.modules</groupId>
			<artifactId>mule-oauth-module</artifactId>
			<version>1.1.24</version>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- VM Connector (persistent queue for async IDP tracking) -->
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-vm-connector</artifactId>
			<version>2.0.1</version>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- IDP Module  -->
		<!-- Scripting Module (Groovy) - used to throttle the IDP status poll loop -->

		<dependency>
			<groupId>org.mule.modules</groupId>
			<artifactId>mule-scripting-module</artifactId>
			<version>2.1.1</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>org.codehaus.groovy</groupId>
			<artifactId>groovy-jsr223</artifactId>
			<version>3.0.19</version>
		</dependency>
		<dependency>
			<groupId>c9f1bc03-6ac9-4c3b-b5e9-fbee2867a61b</groupId>
			<artifactId>mule-plugin-idp-action-3dd6703a-e0b2-4f26-ab56-4e0d7dacfd9d</artifactId>
			<version>1.4.0</version>
			<classifier>mule-plugin</classifier>
		</dependency>
	</dependencies>
	<repositories>
		<repository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange</name>
			<url>https://maven.eu1.anypoint.mulesoft.com/api/v3/maven</url>
			<layout>default</layout>
		</repository>
		<repository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<url>https://repository.mulesoft.org/nexus/repository/releases/</url>
			<layout>default</layout>
		</repository>
	</repositories>
	<pluginRepositories>
		<pluginRepository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<layout>default</layout>
			<url>https://repository.mulesoft.org/nexus/repository/releases/</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>
</project>
