## SECTION SPECS STRUCTURE (excerpt — see `templates/wsr-section-specs.yaml` for full)

```yaml
metadata:
  agent_version: "1.2.0"
  parser_endpoint: "gdc-project-collaboration@salesforce.com"
  date_format: "dd-mmm-yy"
  subject_regex: '^WSR \| \d{2}-[A-Z][a-z]{2}-\d{2} \| .+ \| Status - (Green|Amber|Red) \| .+$'

inference_policy:
  modes: { mode_a_reference, mode_b_fresh }
  auto_detect: true
  ask_only_if_missing: true
  date_policy: "always_today_never_ask"
  parser_script: null                     # v1.2: LLM-native

days_calculation:
  source_file: "templates/team-roster.yaml"
  formula: "new_total = prior_total + (active_members × 5 × weeks_elapsed) − sum(leaves)"
  calculator_script: "lib/calculators/days_calculator.py"

metrics_inference:
  prompt_to_user: "Paste your Jira sprint export OR describe this week's metrics ..."
  inference_script: null                  # v1.2: LLM-native
  computation_script: "lib/calculators/metrics_calculator.py"

output_artifacts:
  directory_pattern: "project/output_wsr/{YYYY-MM-DD-HHmm}_{project-slug}/"
  files: [subject.txt, email_body.html, validation_report.md, run_metadata.json]   # 4, not 6
  chat_only: [plain-text preview, gap list]
```

