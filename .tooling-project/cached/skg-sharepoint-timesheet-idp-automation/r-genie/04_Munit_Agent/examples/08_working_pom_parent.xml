<?xml version="1.0" encoding="UTF-8"?>
<!-- 🧞‍♂️ R-GENIE POM CONFIGURATION EXAMPLE -->
<!-- Pattern: Simple MUnit config that works with parent POM inheritance -->
<!-- Source: SAP Delivery API (s-sap-delivery-api-gr) - Production validated -->

<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<groupId>com.example</groupId>
	<artifactId>s-sap-delivery-api-gr</artifactId>
	<version>1.0.0</version>
	<packaging>mule-application</packaging>
	
	<!-- ✅ Parent POM Inheritance -->
	<parent>
		<groupId>com.company</groupId>
		<artifactId>heineken-parent-pom</artifactId>
		<version>1.0.16</version>
	</parent>
	
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<munit.version>3.3.0</munit.version>
		<mule.maven.plugin.version>4.3.1</mule.maven.plugin.version>
	</properties>
	
	<build>
		<plugins>
			<!-- ✅ WORKING MUNIT CONFIGURATION -->
			<plugin>
				<groupId>com.mulesoft.munit.tools</groupId>
				<artifactId>munit-maven-plugin</artifactId>
				<version>${munit.version}</version>
				<executions>
					<execution>
						<id>test</id>
						<phase>test</phase>
						<goals>
							<goal>test</goal>
							<goal>coverage-report</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<!-- ⚠️ NO runtimeConfiguration (causes enum error with parent POM) -->
					<!-- ⚠️ NO munitTestsDirectory (auto-discovers src/test/munit/) -->
					<coverage>
						<runCoverage>true</runCoverage>
						<formats>
							<format>html</format>
						</formats>
					</coverage>
				</configuration>
			</plugin>
			
			<plugin>
				<groupId>org.mule.tools.maven</groupId>
				<artifactId>mule-maven-plugin</artifactId>
				<version>${mule.maven.plugin.version}</version>
				<extensions>true</extensions>
			</plugin>
		</plugins>
	</build>
	
	<dependencies>
		<!-- MUnit Dependencies -->
		<dependency>
			<groupId>com.mulesoft.munit</groupId>
			<artifactId>munit-runner</artifactId>
			<version>${munit.version}</version>
			<classifier>mule-plugin</classifier>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.mulesoft.munit</groupId>
			<artifactId>munit-tools</artifactId>
			<version>${munit.version}</version>
			<classifier>mule-plugin</classifier>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
