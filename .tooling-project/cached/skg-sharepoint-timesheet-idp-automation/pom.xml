              <businessGroupId>${project.groupId}</businessGroupId>
              <skipDeploymentVerification>${anypoint.skipDeploymentVerification}</skipDeploymentVerification>
              <properties>
                <anypoint.platform.visualizer.layer>${api.layer}</anypoint.platform.visualizer.layer>
                <mule.env>${anypoint.properties.env}</mule.env>
                <anypoint.platform.client_id>${anypoint.clientId}</anypoint.platform.client_id>
                <anypoint.platform.base_uri>${anypoint.base_uri}</anypoint.platform.base_uri>
                <anypoint.platform.analytics_base_uri>${anypoint.platform.analytics_base_uri}</anypoint.platform.analytics_base_uri>
              </properties>
              <secureProperties>
