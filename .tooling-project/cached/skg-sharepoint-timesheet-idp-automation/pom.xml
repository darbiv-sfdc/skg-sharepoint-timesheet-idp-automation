                    <publicUrl>${anypoint.publicUrl}</publicUrl>
                    <lastMileSecurity>${anypoint.lastMile}</lastMileSecurity>
                    <forwardSslSession>${anypoint.forwardSession}</forwardSslSession>
                  </inbound>
                </http>
              </deploymentSettings>
              <integrations>
                <services>
                  <objectStoreV2>
                    <enabled>${anypoint.objectStoreV2}</enabled>
