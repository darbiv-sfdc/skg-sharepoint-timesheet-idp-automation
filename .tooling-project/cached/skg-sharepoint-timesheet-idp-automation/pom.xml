              <id>default-install</id>
              <phase>none</phase>
            </execution>
            <execution>
              <id>deploy</id>
              <goals>
                <goal>deploy</goal>
              </goals>
            </execution>
          </executions>
          <configuration>
            <cloudhub2Deployment>
              <muleVersion>${app.runtime}</muleVersion>
