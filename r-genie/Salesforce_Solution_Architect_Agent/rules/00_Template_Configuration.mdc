## TEMPLATE STRUCTURE — 12 Sections (Fixed Order, All Mandatory)

```yaml
deliverable:
  filename_pattern: "{scenario-slug}-solution-architecture.md"
  output_dir: "project/output_salesforce_solution_architect/"
  verbosity_anchor: "examples/01_fnol_insurance_guidewire/solution_architecture_fnol_guidewire.md"
  target_lines: "400-700 (Medium-form HLD; benchmark against anchor)"

structure:
  # ─── MAIN SECTIONS (all 12 mandatory, fixed order) ───
  sections:
    - id: 1
      name: "Business & Technical Context"
      marker: "<!-- SECTION: business-technical-context -->"
      include: true             # NEVER false — mandatory
      written_in_phase: 0
      written_via: "edit (replace marker placeholder block)"
      content_summary: "Scenario, business drivers, stakeholders, success criteria, in-scope/out-of-scope, key NFRs, regulatory context"
      sub_stops: 0

    - id: 2
      name: "Recommended Architecture"
      marker: "<!-- SECTION: recommended-architecture -->"
      include: true
      written_in_phase: 1
      written_via: "edit"
      content_summary: "SFDC clouds, integration platform, key components, design patterns, with TRADE-OFF TABLE for major decisions"
      sub_stops: 0

    - id: 3
      name: "Architecture Diagram"
      marker: "<!-- SECTION: architecture-diagram -->"
      include: true
      written_in_phase: 2
      written_via: "edit (insert Mermaid block)"
      content_summary: "Mermaid flowchart/graph diagram per @02_Guidance.mdc Mermaid standards (linear curve, <br/> not \\n, styles at end)"
      sub_stops: 0

    - id: 4
      name: "Data Model Design"
      marker: "<!-- SECTION: data-model-design -->"
      include: true
      written_in_phase: 3
      written_via: "edit"
      content_summary: "Entities, fields, relationships, FSC/Industry Cloud objects vs custom; record types, sharing model"
      sub_stops: 1                  # Phase 3 sub-stop 4-a

    - id: 5
      name: "Data Model Diagram (Lucidchart Instructions)"
      marker: "<!-- SECTION: data-model-diagram -->"
      include: true
      written_in_phase: 3
      written_via: "edit"
      content_summary: "Step-by-step Lucidchart create-document instructions: shapes, entities, relationships, cardinality. NOT Mermaid (data model viz handled in Lucidchart per agent convention)"
      sub_stops: 1                  # Phase 3 sub-stop 4-b

    - id: 6
      name: "Integration & Event Pattern"
      marker: "<!-- SECTION: integration-event-pattern -->"
      include: true
      written_in_phase: 4
      written_via: "edit"
      content_summary: "Async vs sync vs event-driven, Platform Events / CDC / Pub-Sub API, message contracts, retry/replay, dead-letter handling"
      sub_stops: 0

    - id: 7
      name: "Automation & Orchestration"
      marker: "<!-- SECTION: automation-orchestration -->"
      include: true
      written_in_phase: 5
      written_via: "edit"
      content_summary: "Flows, triggers, batch jobs, Async Apex, Queueable, scheduled jobs, orchestration patterns (Saga / Choreography / Orchestration)"
      sub_stops: 0

    - id: 8
      name: "Security & Compliance"
      marker: "<!-- SECTION: security-compliance -->"
      include: true
      written_in_phase: 6
      written_via: "edit"
      content_summary: "Auth model (SSO, OAuth, JWT), encryption (Shield, field-level), PII/PHI classification, sharing/visibility, HIPAA/PCI/GDPR/SOX posture, audit logging"
      sub_stops: 0

    - id: 9
      name: "Scalability & Performance"
      marker: "<!-- SECTION: scalability-performance -->"
      include: true
      written_in_phase: 7
      written_via: "edit"
      content_summary: "Sizing math with EXPLICIT ARITHMETIC (TPS sustained + peak), governor limits, bulk patterns, caching, async offload, queue depth"
      sub_stops: 1                  # Phase 7 sub-stop 8-a; numeric verification required
      numeric_verification_required: true

    - id: 10
      name: "Reusability & Productization"
      marker: "<!-- SECTION: reusability-productization -->"
      include: true
      written_in_phase: 7
      written_via: "edit"
      content_summary: "Reusable accelerators (>=3 named), unlocked packages, managed package potential, multi-org/multi-tenant considerations"
      sub_stops: 1                  # Phase 7 sub-stop 8-b

    - id: 11
      name: "Risks & Mitigations"
      marker: "<!-- SECTION: risks-mitigations -->"
      include: true
      written_in_phase: 8
      written_via: "edit"
      content_summary: "Risk register table (>=5 rows): risk, likelihood, impact, mitigation, owner"
      sub_stops: 1                  # Phase 8 sub-stop 9-a

    - id: 12
      name: "References"
      marker: "<!-- SECTION: references -->"
      include: true
      written_in_phase: 8
      written_via: "edit"
      content_summary: "SFDC Trailhead, official docs, whitepapers, vendor docs (Guidewire/MuleSoft/etc.) — credible sources only, no marketing pages"
      sub_stops: 1                  # Phase 8 sub-stop 9-b

  # ─── CONSOLIDATE & POLISH (Phase 8 final mode) ───
  consolidate_phase:
    phase: 8
    mode: "CONSOLIDATE_AND_POLISH"
    tasks:
      - "Re-read full deliverable file"
      - "Cross-section consistency edits (entity names, terminology, vendor naming)"
      - "Replace any residual placeholders left by skipped/incomplete phases"
      - "Run validate-solution-doc.js (mandatory script)"
      - "Apply script-flagged fixes"
      - "Final style + length self-check against verbosity_anchor"
      - "Verify all 12 section markers replaced (no <!-- SECTION: ... --> remaining as standalone)"
    forbidden:
      - "Regenerating sections already written and approved in Phases 0-7"
      - "Adding new content not previously approved"
```

