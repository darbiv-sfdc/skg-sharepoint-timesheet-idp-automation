            <munit-tools:variable key="{TARGET_VAR}" 
                value='#[output application/json --- MunitTools::getResourceAsString("test-data/response.json")]' 
                encoding="UTF-8" mediaType="application/json"/>
        </munit-tools:variables>
    </munit-tools:then-return>
</munit-tools:mock-when>
```

