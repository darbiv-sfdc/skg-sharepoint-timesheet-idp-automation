#%RAML 1.0 Trait

description: Pagination support
queryParameters:
  page:
    type: integer
    default: 1
    minimum: 1
    description: Page number
  pageSize:
    type: integer
    default: 20
    minimum: 1
    maximum: 100
    description: Items per page
  sortBy?:
    type: string
    description: Field to sort by
  sortOrder?:
    type: string
    enum: [asc, desc]
    default: asc
